# ---------------------------------------------------------------------------
# Copy this file to frontend/.env  and fill in the value.
#   cp frontend/.env.example frontend/.env
#
# ⚠️ EVERY variable that starts with VITE_ is baked into the website and is
# readable by anyone who opens your site. So:
#   ✅ Put the public backend URL here.
#   ❌ NEVER put a Supabase service role key, database password or any
#      other secret here.
# ---------------------------------------------------------------------------

# Where your backend runs.
# Locally:  http://localhost:4000
# Deployed: the URL your backend host gives you, e.g.
#           https://proofwork-api.onrender.com
VITE_API_URL=https://dnfudevhbxvdpggpbhsm.supabase.co/rest/v1/
